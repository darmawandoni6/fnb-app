meta {
  name: Get menu
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/public/tables/{{qrToken}}/menu
  body: none
  auth: none
}

tests {
  test("returns menu", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.categories).to.be.an("array");
  });
}
