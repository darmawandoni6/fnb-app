meta {
  name: Cancel public order
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/public/orders/{{orderId}}/cancel
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Session-Token: {{sessionToken}}
}

body:json {
  {
    "reason": "Changed my mind"
  }
}

tests {
  test("cancels public order", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal("DIBATALKAN");
  });
}
