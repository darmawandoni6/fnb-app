meta {
  name: Update staff user
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/users/{{userId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Cashier",
    "is_active": false
  }
}

tests {
  test("updates user", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}
