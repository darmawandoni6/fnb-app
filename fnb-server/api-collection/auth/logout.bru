meta {
  name: Logout
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  # Logout

  Sends the `refresh_token` cookie back to the API, which revokes the session
  and clears the cookie. Safe to call without a cookie.
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", "");
  }
}

tests {
  test("returns successful logout response", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.message).to.equal("logged out successfully");
  });
}
