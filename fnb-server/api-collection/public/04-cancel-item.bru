meta {
  name: Cancel order item
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/public/orders/{{trackingToken}}/cancel
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "item_id": "{{itemId}}"
  }
}

tests {
  test("cancels order item", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}
