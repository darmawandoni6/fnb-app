vars {
  @description('''Local API base URL''')
  baseUrl: http://localhost:8081

  @description('''Access token returned by login''')
  accessToken:

  @description('''Demo table QR token''')
  qrToken: demo-qr-token

  @description('''Menu ID used by create-order request''')
  menuId: 00000000-0000-0000-0000-000000000010

  @description('''Order tracking token returned by create-order''')
  trackingToken:

  @description('''Order item ID returned by create-order''')
  itemId:

  @description('''Internal order ID''')
  orderId:

  @description('''Internal order item ID''')
  orderItemId:

  @description('''Menu category ID''')
  categoryId:

  @description('''Menu ID for administration''')
  adminMenuId:

  @description('''Table ID''')
  tableId:

  @description('''Ingredient ID''')
  ingredientId:

  @description('''Recipe item ID''')
  recipeItemId:

  @description('''Recipe menu ID''')
  recipeMenuId: 00000000-0000-0000-0000-000000000010

  @description('''Recipe ingredient ID''')
  recipeIngredientId:

  @description('''Internal user ID''')
  userId:
}
