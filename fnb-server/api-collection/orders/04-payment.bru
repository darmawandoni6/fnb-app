meta {
  name: Update payment
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/orders/{{orderId}}/payment
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "payment_status": "LUNAS",
    "payment_method": "CASH"
  }
}

tests {
  test("marks order as paid", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.payment_status).to.equal("LUNAS");
  });
}
