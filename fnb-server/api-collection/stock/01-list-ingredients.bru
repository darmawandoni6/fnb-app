meta {
  name: List ingredients
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/ingredients
  body: none
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
tests {
  test("lists ingredients", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
  });
}
