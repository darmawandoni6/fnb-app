meta {
  name: Update ingredient
  type: http
  seq: 3
}
patch {
  url: {{baseUrl}}/ingredients/{{ingredientId}}
  body: json
  auth: bearer
}
headers {
  Content-Type: application/json
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  {
    "name": "Coffee beans",
    "unit": "kg",
    "min_stock": 2
  }
}
tests {
  test("updates ingredient", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}
