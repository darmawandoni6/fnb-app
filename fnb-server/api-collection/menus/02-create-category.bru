meta {
  name: Create menu category
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/menu-categories
  body: json
  auth: bearer
}
headers {
  Content-Type: application/json
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  {
    "name": "Coffee",
    "sort_order": 1
  }
}
script:post-response {
  if (res.status < 300 && res.body.success === true) {
    bru.setVar("categoryId", res.body.data.id);
  }
}

tests {
  test("creates category", function() {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
  });
}
