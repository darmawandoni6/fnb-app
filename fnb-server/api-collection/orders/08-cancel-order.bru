meta {
  name: Cancel order
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/orders/{{orderId}}/cancel
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "reason": "Customer cancelled"
  }
}

tests {
  test("cancels order", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal("DIBATALKAN");
  });
}
