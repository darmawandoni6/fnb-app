meta {
  name: Confirm payment
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/orders/{{orderId}}/payment
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "payment_method": "CASH",
    "amount_received": 100000,
    "change_amount": 42250
  }
}

tests {
  test("marks order as paid", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.payment_status).to.equal("LUNAS");
    expect(res.body.data.paid_at).to.be.a("string");
  });
}
