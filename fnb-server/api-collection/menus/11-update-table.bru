  body: json
  auth: bearer
}
headers {
  Content-Type: application/json
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  {
    "table_number": "T01",
    "qr_token": "public-token"
  }
}
tests {
  test("updates table", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}
