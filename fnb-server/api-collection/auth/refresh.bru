meta {
  name: Refresh token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/refresh
  body: none
  auth: none
}

tests {
  test("returns a refreshed access token", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.access_token).to.be.a("string");
  });
}
