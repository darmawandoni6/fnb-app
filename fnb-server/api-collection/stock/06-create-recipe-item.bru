meta {
  name: Create recipe item
  type: http
  seq: 8
}
post {
  url: {{baseUrl}}/recipe-items
  body: json
  auth: bearer
}
headers {
  Content-Type: application/json
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  {
    "menu_id": "{{recipeMenuId}}",
    "ingredient_id": "{{recipeIngredientId}}",
    "qty_used": 0.02
  }
}
script:post-response {
  if (res.status < 300 && res.body.success === true) {
    bru.setVar("recipeItemId", res.body.data.id);
  }
}

tests {
  test("creates recipe item", function() {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.equal(true);
  });
}
