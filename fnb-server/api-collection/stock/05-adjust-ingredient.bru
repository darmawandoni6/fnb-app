meta {
  name: Adjust ingredient
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/ingredients/{{ingredientId}}/adjust
  body: json
  auth: bearer
}
headers {
  Content-Type: application/json
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  {
    "stock_qty": 60,
    "note": "Stock opname"
  }
}
tests {
  test("adjusts ingredient", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.stock_qty).to.equal(60);
  });
}
