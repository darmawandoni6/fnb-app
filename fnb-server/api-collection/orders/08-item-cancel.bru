meta {
  name: Cancel item
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/orders/{{orderId}}/items/{{orderItemId}}/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("cancels item", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}
